# discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# commands
PREFIX=w!
OWNER_IDS=
MODLOG_CHANNEL_ID=

# ai providers to try in order (comma separated: openai,gemini,groq,other)
AI_PROVIDERS=openai,gemini,groq,other

# openai (up to 10 keys: AI_OPENAI_KEY_1 through AI_OPENAI_KEY_10)
AI_OPENAI_KEY_1=
AI_OPENAI_KEY_2=
AI_OPENAI_KEY_3=
AI_OPENAI_KEY_4=
AI_OPENAI_KEY_5=
AI_OPENAI_KEY_6=
AI_OPENAI_KEY_7=
AI_OPENAI_KEY_8=
AI_OPENAI_KEY_9=
AI_OPENAI_KEY_10=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini

# google gemini (up to 10 keys: AI_GEMINI_KEY_1 through AI_GEMINI_KEY_10)
AI_GEMINI_KEY_1=
AI_GEMINI_KEY_2=
AI_GEMINI_KEY_3=
AI_GEMINI_KEY_4=
AI_GEMINI_KEY_5=
AI_GEMINI_KEY_6=
AI_GEMINI_KEY_7=
AI_GEMINI_KEY_8=
AI_GEMINI_KEY_9=
AI_GEMINI_KEY_10=
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_GEMINI_MODEL=gemini-1.5-flash

# groq (up to 10 keys: AI_GROQ_KEY_1 through AI_GROQ_KEY_10)
AI_GROQ_KEY_1=
AI_GROQ_KEY_2=
AI_GROQ_KEY_3=
AI_GROQ_KEY_4=
AI_GROQ_KEY_5=
AI_GROQ_KEY_6=
AI_GROQ_KEY_7=
AI_GROQ_KEY_8=
AI_GROQ_KEY_9=
AI_GROQ_KEY_10=
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_MODEL=llama-3.1-70b-versatile

# custom openai-compatible provider (up to 10 keys: AI_OTHER_KEY_1..10)
AI_OTHER_KEY_1=
AI_OTHER_KEY_2=
AI_OTHER_BASE_URL=
AI_OTHER_MODEL=

# global ai tuning
AI_MAX_STEPS=8
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=3000

# legacy fallback (used if AI_PROVIDERS is omitted)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# let the agent run delete/ban/lockdown class capabilities without asking
AI_ALLOW_DESTRUCTIVE=true

# allow @wellix to write new event-driven features into data/generated
SELFBUILD=false

# storage
DATA_DIR=./data

# bot presence / "bio" (shows under the bot's name)
BOT_ACTIVITY=w!help · 100 commands
BOT_ACTIVITY_TYPE=playing   # playing | streaming | listening | watching | competing
