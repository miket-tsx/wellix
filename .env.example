# discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# commands
PREFIX=w!
OWNER_IDS=
MODLOG_CHANNEL_ID=

# ai (any openai compatible endpoint works)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_STEPS=8
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=3000

# let the agent run delete/ban/lockdown class capabilities without asking
AI_ALLOW_DESTRUCTIVE=true

# allow @wellix to write new event-driven features into data/generated
SELFBUILD=false

# storage
DATA_DIR=./data
